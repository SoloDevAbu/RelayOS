DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workflow_engine

REDIS_URL=redis://localhost:6379

INTERNAL_SERVICE_SECRET=local-dev-secret-change-this-in-production

# AES-256-GCM master key for tool credential encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: losing this key makes all stored tool credentials unrecoverable.
ENCRYPTION_MASTER_KEY=

# Service ports
PLATFORM_API_PORT=3002
INGESTION_SERVICE_PORT=3001
WORKFLOW_SERVICE_PORT=3003
AGENT_SERVICE_PORT=3004
MEMORY_SERVICE_PORT=3005
TOOL_RUNTIME_PORT=3006

# Auth — JWT (used by apps/api)
JWT_SECRET=local-dev-jwt-secret-change-in-production-min32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000

# AI
GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=

# Observability (add in Phase 13)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

NODE_ENV=development
LOG_LEVEL=info